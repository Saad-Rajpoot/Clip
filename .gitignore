# ===== secrets (NEVER commit) =====
.env
.env.*
!.env.example
.secrets/
*.key
*.pem

# ===== python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ===== virtualenvs =====
.venv/
.hdvenv/
venv/
env/

