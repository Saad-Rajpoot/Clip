output/
editor_cache/
last_ffmpeg_fail.txt

# YTAL USE-ONLY raw audio cache — local runtime/dev library; NEVER bundled in dist.
# (Manifests live in vidlore/audio_library/ and ARE committed; only the raw cache is ignored.)
vidlore/audio_library/ytal_cache/

