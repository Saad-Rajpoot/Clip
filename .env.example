# Copy to .env and fill what you have. Empty = free fallback is used.

# === EDITOR BRAIN (recommended for Vidlore-level quality) ===========
# With a key, the LLM acts as the documentary EDITOR: it takes YOUR
# script (passed via --script, words kept verbatim) and decides scene
# cuts, the exact cinematic shot per line, the emphasis word, emotional
# intensity and pacing. Without a key it falls back to a heuristic cut.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# === PRIMARY VISUAL ENGINE: fal.ai FLUX (recommended) ===============
# Each scene's image is generated from the editor's exact shot prompt,
# so footage always matches the sentence and looks cinematic. Get a key
# at fal.ai/dashboard/keys (paid, ~$0.01-0.04/image). schnell = fast/
# cheap, flux/dev = higher fidelity for hero shots.
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell

# OPTIONAL — true MOTION (real moving clip per scene, the biggest
# 'not a still' Vidlore jump). Leave EMPTY = cheap AI stills + Ken
# Burns (~$0.15/video). Set a fal video model for real footage:
#   fal-ai/ltxv-13b-098-distilled   ~$0.10/scene  (cheapest, ~1-2 min/clip)
#   fal-ai/wan/v2.2-5b/text-to-video ~$0.15/scene  (best quality/$)
# A 16-scene video ≈ $1.5-2.5 + several minutes (clips run in parallel,
# then cached so re-renders are instant). Cost scales with scenes.
FAL_VIDEO_MODEL=

# Real stock VIDEO tier (optional, free key at pexels.com/api). Used
# when fal.ai is not set. (A normal Storyblocks subscription does NOT
# include API access — that is enterprise-only — so Pexels is the
# free, license-clean stock-video option here.)
PEXELS_API_KEY=

# Optional tier-2 stock video — fallback when Pexels missed the
# specific query.  Note: search-only / free-trial tokens return
# WATERMARKED preview MP4s (a one-line warning prints the first
# time one is used).  A paid Shutterstock API subscription returns
# clean previews after a license call (license flow not wired yet).
SHUTTERSTOCK_API_KEY=

# B-roll footage tier 2 (DEFAULT, free, keyless): Openverse — a real,
# content-relevant Creative-Commons photo per scene. No key needed.
# Tier 2b (optional): set a Pollinations secret key (sk_... from
# enter.pollinations.ai) to instead generate a UNIQUE AI image per scene
# (keyless Pollinations is unreliable, so a key is required to use it);
# it auto-falls back to Openverse, then to slides.
# VIDLORE_AIMG=0 disables both and uses plain themed slide cards.
POLLINATIONS_API_KEY=
VIDLORE_AIMG=1

# === REAL PHOTOS of the actual subject (documentary look) ==========
# Tried BEFORE any AI image, so a genuine photo wins whenever one
# exists; abstract scenes still fall through to AI automatically.
# Wikimedia Commons is free + KEYLESS (on by default; set 0 to disable).
VIDLORE_WIKIMEDIA=1
# Pixabay + Unsplash add even more real, commercial-safe photos. Both
# need a FREE key — leave empty to skip that source (nothing breaks):
#   Pixabay   -> https://pixabay.com/api/docs/   (free, instant)
#   Unsplash  -> https://unsplash.com/developers  (free, "Access Key")
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Scenes are fetched in parallel (AI image gen is ~slow per image but
# overlapped, then cached so re-renders are instant). Raise for a faster
# first render if your network/Pollinations limits allow.
VIDLORE_FOOTAGE_WORKERS=5
# Motivated sound design: a soft low boom when a high-energy scene
# lands + a quiet riser just before it (calm cuts stay silent). On by
# default. Set to 0 to disable and rely on the music bed alone.
VIDLORE_SFX=1

# Voice tier 1 (edge-tts, free, no key — the default). Override if you want.
VIDLORE_VOICE=en-US-GuyNeural

# Voice tier 2 (optional, Vidlore's real engine). If ELEVENLABS_API_KEY is
# set, narration uses ElevenLabs; a per-scene failure auto-falls back to
# edge-tts so a render never dies. Voice id default = "Adam" (narrator).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Background music. A theme-matched ambient bed is synthesized for free
# (no key, royalty-free) and ducked under the narration. A track set via
# brief.music always overrides it. Set to 0 (or pass --no-music) for none.
VIDLORE_MUSIC=1

# Scene transitions. Smooth crossfades between scenes (vs hard cuts) —
# fixes the "samey" amateur jump-cut look. Set to 0 (or --no-transitions)
# for hard cuts. Auto-falls back to hard cuts if a scene is too short.
VIDLORE_TRANSITIONS=1

# On-screen overlays: a fading title card for the first ~3.5s and a
# lower-third "SUBSCRIBE" call-to-action (the finished-video polish).
# Set to 0 (or pass --no-overlays) to disable.
VIDLORE_OVERLAYS=1
